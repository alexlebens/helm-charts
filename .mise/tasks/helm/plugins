#!/usr/bin/env bash
#MISE description="Install required Helm plugins (cm-push, unittest)"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: mise run helm:plugins"
  echo "Installs required Helm plugins (cm-push, unittest) if not already installed."
  exit 0
fi

log_step "Checking required Helm plugins"

PLUGINS_LIST=$(helm plugin list 2>/dev/null || true)

# 1. chartmuseum/helm-push
if echo "${PLUGINS_LIST}" | grep -q "cm-push"; then
  log_info "Plugin cm-push is already installed."
else
  log_info "Installing chartmuseum/helm-push plugin ..."
  helm plugin install https://github.com/chartmuseum/helm-push --verify=false >/dev/null 2>&1 || true
fi

# 2. helm-unittest/helm-unittest
if echo "${PLUGINS_LIST}" | grep -q "unittest"; then
  log_info "Plugin unittest is already installed."
else
  log_info "Installing helm-unittest/helm-unittest plugin ..."
  helm plugin install https://github.com/helm-unittest/helm-unittest.git --verify=false >/dev/null 2>&1 || true
fi

log_success "All required Helm plugins are installed!"
