#!/usr/bin/env bash
#MISE description="Run chart-testing ct lint against charts"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

CHARTS="${CHARTS:-}"
TARGET_BRANCH="${TARGET_BRANCH:-main}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --chart)
      CHARTS="${CHARTS} $2"
      shift 2
      ;;
    --charts)
      CHARTS="$2"
      shift 2
      ;;
    --target-branch)
      TARGET_BRANCH="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: mise run check:chart [--chart <name>] [--charts <charts>] [--target-branch <branch>]"
      exit 0
      ;;
    *)
      CHARTS="${CHARTS} $1"
      shift
      ;;
  esac
done

cd "${REPO_ROOT}"
CHARTS=$(echo "${CHARTS}" | xargs)

if [ -n "${CHARTS}" ]; then
  "${REPO_ROOT}/.mise/lib/helm-add-repos.sh" --main-dir "${REPO_ROOT}" --charts "${CHARTS}"
fi

# Resolve bundled chart-testing schema & lint configs from mise's aqua install
CT_DIR="$(mise where aqua:helm/chart-testing 2>/dev/null || dirname "$(command -v ct)")"
CT_ARGS=(--validate-maintainers=false --target-branch "${TARGET_BRANCH}")
if [ -f "${CT_DIR}/etc/chart_schema.yaml" ]; then
  CT_ARGS+=(--chart-yaml-schema "${CT_DIR}/etc/chart_schema.yaml")
fi
if [ -f "${CT_DIR}/etc/lintconf.yaml" ]; then
  CT_ARGS+=(--lint-conf "${CT_DIR}/etc/lintconf.yaml")
fi

log_step "Running chart-testing ct lint (target branch: ${TARGET_BRANCH})"
uv run --project "${REPO_ROOT}" --locked ct lint "${CT_ARGS[@]}"
log_success "Chart testing passed!"
