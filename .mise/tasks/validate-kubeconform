#!/usr/bin/env bash
#MISE description="Validate rendered chart manifests with kubeconform against schemas"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd -P))}"
# shellcheck source=../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

CHARTS="${CHARTS:-}"
SCHEMA_DIR="${SCHEMA_DIR:-${HOME}/.schemas}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --chart)
      CHARTS="${CHARTS} $2"
      shift 2
      ;;
    --charts)
      CHARTS="$2"
      shift 2
      ;;
    --schema-dir)
      SCHEMA_DIR="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: mise run validate:kubeconform [--chart <name>] [--charts <names>] [--schema-dir <dir>]"
      exit 0
      ;;
    *)
      CHARTS="${CHARTS} $1"
      shift
      ;;
  esac
done

CHARTS=$(echo "${CHARTS}" | xargs)
if [ -z "${CHARTS}" ]; then
  log_info "No charts specified for Kubeconform validation. Skipping."
  exit 0
fi

cd "${REPO_ROOT}"
log_step "Running kubeconform on charts: ${CHARTS}"
FAILED_CHARTS=""

for CHART in ${CHARTS}; do
  CHART_PATH="charts/${CHART}"
  if [ -f "${CHART_PATH}/Chart.yaml" ]; then
    (
      cd "${CHART_PATH}"
      log_info "Validating ${CHART} (default values) ..."
      helm template . | kubeconform -strict -summary \
        -schema-location default \
        -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' \
        -schema-location "${SCHEMA_DIR}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json"

      if ls ci/*.yaml 1> /dev/null 2>&1; then
        for values_file in ci/*.yaml; do
          log_info "Validating ${CHART} (${values_file}) ..."
          helm template . -f "${values_file}" | kubeconform -strict -summary \
            -schema-location default \
            -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' \
            -schema-location "${SCHEMA_DIR}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json"
        done
      fi
    ) || {
      FAILED_CHARTS="${FAILED_CHARTS} ${CHART}"
    }
  fi
done

if [ -n "${FAILED_CHARTS}" ]; then
  log_fatal "Kubeconform failed for: ${FAILED_CHARTS}"
fi

log_success "All charts passed Kubeconform validation!"
