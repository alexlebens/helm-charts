{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "kubernetesClusterName": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["postgresql"]
    },
    "mode": {
      "type": "string",
      "enum": ["standalone", "recovery"]
    },
    "externalSecretStoreName": {
      "type": "string"
    },
    "cluster": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "imageCatalogRef": {
          "type": "object",
          "properties": {
            "apiGroup": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": ["ClusterImageCatalog", "ImageCatalog"]
            },
            "name": {
              "type": "string"
            },
            "major": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "walStorage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "enablePDB": {
          "type": "boolean"
        },
        "enableSuperuserAccess": {
          "type": "boolean"
        },
        "primaryUpdateMethod": {
          "type": "string",
          "enum": ["switchover", "restart"]
        },
        "primaryUpdateStrategy": {
          "type": "string",
          "enum": ["unsupervised", "supervised"]
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "additionalLabels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "inheritedMetadata": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "object"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "object"
            },
            "synchronous": {
              "type": "object"
            },
            "shared_preload_libraries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pg_hba": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pg_ident": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ldap": {
              "type": "object",
              "properties": {
                "server": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                },
                "scheme": {
                  "type": "string",
                  "enum": ["ldap", "ldaps"]
                },
                "bindAsAuth": {
                  "type": "object"
                },
                "bindSearchAuth": {
                  "type": "object"
                }
              }
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "image": {
                    "type": "object"
                  },
                  "dynamic_library_path": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "extension_control_path": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ld_library_path": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "bin_path": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "array"
                  }
                }
              }
            },
            "promotionTimeout": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "enableAlterSystem": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["import", "backup", "objectStore"]
        },
        "objectStore": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "destinationBucket": {
              "type": "string"
            },
            "destinationPathOverride": {
              "type": "string"
            },
            "endpointURL": {
              "type": "string"
            },
            "clusterName": {
              "type": "string"
            },
            "serverNameOverride": {
              "type": "string"
            },
            "index": {
              "type": "integer"
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "backupServerName": {
          "type": "string"
        },
        "objectStore": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "isWALArchiver": {
              "type": "boolean"
            },
            "destinationBucket": {
              "type": "string"
            },
            "destinationPathOverride": {
              "type": "string"
            },
            "endpointURL": {
              "type": "string"
            },
            "retentionPolicy": {
              "type": "string"
            },
            "index": {
              "type": "integer"
            }
          }
        }
      }
    },
    "roles": {
      "type": "array"
    },
    "imageCatalog": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "major": {
                "type": "integer",
                "minimum": 1
              },
              "image": {
                "type": "string"
              },
              "extensions": {
                "type": "array"
              }
            }
          }
        },
        "componentImages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "databases": {
      "type": "array"
    },
    "poolers": {
      "type": "array"
    }
  }
}
