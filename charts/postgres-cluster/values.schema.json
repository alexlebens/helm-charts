{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "kubernetesClusterName": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["postgresql"]
    },
    "mode": {
      "type": "string",
      "enum": ["standalone", "recovery"]
    },
    "externalSecretStoreName": {
      "type": "string"
    },
    "cluster": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "walStorage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "enablePDB": {
          "type": "boolean"
        },
        "enableSuperuserAccess": {
          "type": "boolean"
        },
        "primaryUpdateMethod": {
          "type": "string",
          "enum": ["switchover", "restart"]
        },
        "primaryUpdateStrategy": {
          "type": "string",
          "enum": ["unsupervised", "supervised"]
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "additionalLabels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["import", "backup", "objectStore"]
        }
      }
    },
    "backup": {
      "type": "object"
    },
    "roles": {
      "type": "array"
    },
    "databases": {
      "type": "array"
    },
    "poolers": {
      "type": "array"
    }
  }
}
