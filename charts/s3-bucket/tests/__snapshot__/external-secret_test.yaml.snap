should match the snapshot with backups enabled:
  1: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: my-bkt
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: my-bkt-secret
        app.kubernetes.io/part-of: my-bkt
        app.kubernetes.io/version: v1.76.0
        helm.sh/chart: s3-bucket-0.10.0
      name: my-bkt-secret
      namespace: ns
    spec:
      data:
        - remoteRef:
            key: /cl01tl/garage/keys/my-bkt
            property: AWS_ACCESS_KEY_ID
          secretKey: accessKeyId
        - remoteRef:
            key: /cl01tl/garage/keys/my-bkt
            property: AWS_SECRET_ACCESS_KEY
          secretKey: secretAccessKey
        - remoteRef:
            key: /cl01tl/garage/keys/my-bkt
            property: AWS_REGION
          secretKey: region
        - remoteRef:
            key: /cl01tl/garage/config
            property: ENDPOINT
          secretKey: endpoint
      secretStoreRef:
        kind: ClusterSecretStore
        name: openbao
      target:
        creationPolicy: Owner
        deletionPolicy: Retain
        template:
          data:
            AWS_ACCESS_KEY_ID: '{{ .accessKeyId }}'
            AWS_REGION: '{{ .region }}'
            AWS_SECRET_ACCESS_KEY: '{{ .secretAccessKey }}'
            access-key-id: '{{ .accessKeyId }}'
            endpoint: '{{ .endpoint }}'
            region: '{{ .region }}'
            secret-access-key: '{{ .secretAccessKey }}'
          engineVersion: v2
  2: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: my-bkt
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: my-bkt-secret-backup-a
        app.kubernetes.io/part-of: my-bkt
        app.kubernetes.io/version: v1.76.0
        helm.sh/chart: s3-bucket-0.10.0
      name: my-bkt-secret-backup-a
      namespace: ns
    spec:
      data:
        - remoteRef:
            key: /ps02sn/garage/keys/my-bkt
            property: AWS_ACCESS_KEY_ID
          secretKey: AWS_ACCESS_KEY_ID
        - remoteRef:
            key: /ps02sn/garage/keys/my-bkt
            property: AWS_SECRET_ACCESS_KEY
          secretKey: AWS_SECRET_ACCESS_KEY
        - remoteRef:
            key: /ps02sn/garage/keys/my-bkt
            property: AWS_REGION
          secretKey: AWS_REGION
        - remoteRef:
            key: /ps02sn/garage/config
            property: ENDPOINT
          secretKey: ENDPOINT
      secretStoreRef:
        kind: ClusterSecretStore
        name: openbao
      target:
        creationPolicy: Owner
        deletionPolicy: Retain
  3: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: my-bkt
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: my-bkt-secret-backup-ntfy
        app.kubernetes.io/part-of: my-bkt
        app.kubernetes.io/version: v1.76.0
        helm.sh/chart: s3-bucket-0.10.0
      name: my-bkt-secret-backup-ntfy
      namespace: ns
    spec:
      data:
        - remoteRef:
            key: /cl01tl/ntfy/config
            property: internal-endpoint
          secretKey: url
        - remoteRef:
            key: /cl01tl/ntfy/topics
            property: rclone
          secretKey: topic
        - remoteRef:
            key: /cl01tl/ntfy/users/cl01tl
            property: token
          secretKey: token
      secretStoreRef:
        kind: ClusterSecretStore
        name: openbao
      target:
        creationPolicy: Owner
        deletionPolicy: Retain
        template:
          data:
            ntfy-token: '{{ .token }}'
            ntfy-url: '{{ .url }}/{{ .topic }}'
          engineVersion: v2
          mergePolicy: Merge
